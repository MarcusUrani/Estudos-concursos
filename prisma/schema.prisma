// Prisma schema — SEDES-DF study platform
// Dev: SQLite (zero setup). Prod: trocar provider para "postgresql" e ajustar DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senha     String
  role      String   @default("user") // "user" | "admin"
  createdAt DateTime @default(now())

  respostas    Resposta[]
  revisoes     Revisao[]
  favoritos    Favorito[]
  metas        Meta[]
  simulados    Simulado[]
  reportes     Reporte[]
  sessoes      SessaoEmAndamento[]
  redacoes     Redacao[]
  temasRedacao TemaRedacao[]

  notificacoesLidas    NotificacaoLida[]
  notificacoesEnviadas Notificacao[]     @relation("NotificacoesEnviadas")
}

// Concurso = topo da hierarquia de conteudo. Cada concurso tem suas proprias
// Materias/Assuntos/Questoes. Concursos diferentes PODEM ter materias com o
// mesmo nome (por isso a unicidade de materia/assunto e por concurso).
model Concurso {
  id    String  @id @default(cuid())
  nome  String  @unique
  sigla String?
  ordem Int     @default(0)

  materias     Materia[]
  assuntos     Assunto[]
  questoes     Questao[]
  simulados    Simulado[]
  sessoes      SessaoEmAndamento[]
  temasRedacao TemaRedacao[]
  notificacoes Notificacao[]
}

// Sessao (treino/simulado/flashcards) iniciada mas nao concluida. Guarda o
// estado para o usuario retomar depois. Uma por usuario+tipo+concurso: iniciar
// uma nova sobrescreve (apaga) a anterior incompleta.
model SessaoEmAndamento {
  id           String   @id @default(cuid())
  tipo         String // "treino" | "simulado" | "flashcards"
  estado       String // JSON com tudo para retomar
  total        Int      @default(0)
  indice       Int      @default(0)
  atualizadaEm DateTime @default(now()) @updatedAt

  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId String?
  concurso   Concurso? @relation(fields: [concursoId], references: [id], onDelete: Cascade)

  @@unique([userId, tipo, concursoId])
  @@index([userId])
}

// Materia = disciplina/area (ex.: "Beneficios e Programas Sociais do DF") que
// agrupa varios Assuntos (cada assunto = uma lei/programa/tema).
model Materia {
  id        String  @id @default(cuid())
  nome      String
  descricao String?
  ordem     Int     @default(0)

  concursoId String?
  concurso   Concurso? @relation(fields: [concursoId], references: [id], onDelete: Cascade)

  assuntos Assunto[]

  @@unique([concursoId, nome])
}

model Assunto {
  id        String  @id @default(cuid())
  nome      String
  descricao String?
  resumo    String? // material de estudo escrito pelo admin (aba "Estudar")
  ordem     Int     @default(0)

  concursoId String?
  concurso   Concurso? @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  materiaId  String?
  materia    Materia?  @relation(fields: [materiaId], references: [id], onDelete: SetNull)

  subassuntos Subassunto[]
  questoes    Questao[]

  @@unique([concursoId, nome])
}

model Subassunto {
  id        String  @id @default(cuid())
  nome      String
  assuntoId String
  assunto   Assunto @relation(fields: [assuntoId], references: [id], onDelete: Cascade)

  questoes Questao[]

  @@unique([assuntoId, nome])
}

model Questao {
  id            String   @id @default(cuid())
  enunciado     String
  nivel         String   @default("Medio") // "Facil" | "Medio" | "Dificil"
  banca         String   @default("QUADRIX")
  explicacao    String
  // `@map` de proposito: o campo passou a se chamar `fonte` porque o banco de
  // questoes deixou de ser so legislacao (portugues, informatica etc. tem fonte
  // que nao e base legal). A COLUNA continua `fonteLegal` para que a mudanca
  // seja so de nome no codigo — sem ALTER TABLE, sem migration, sem risco no
  // banco de producao, que e o mesmo usado em desenvolvimento.
  fonte         String?  @map("fonteLegal")
  palavrasChave String? // CSV (SQLite nao tem arrays nativos)
  dificuldade   Int      @default(3) // 1..5
  tempoMedio    Int      @default(60) // segundos
  createdAt     DateTime @default(now())

  concursoId   String?
  concurso     Concurso?   @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  assuntoId    String
  assunto      Assunto     @relation(fields: [assuntoId], references: [id], onDelete: Cascade)
  subassuntoId String?
  subassunto   Subassunto? @relation(fields: [subassuntoId], references: [id], onDelete: SetNull)

  alternativas Alternativa[]
  respostas    Resposta[]
  revisoes     Revisao[]
  favoritos    Favorito[]
  reportes     Reporte[]

  @@index([assuntoId])
  @@index([concursoId])
}

model Alternativa {
  id        String  @id @default(cuid())
  texto     String
  correta   Boolean @default(false)
  ordem     Int     @default(0)
  questaoId String
  questao   Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  respostas Resposta[]
}

model Resposta {
  id           String   @id @default(cuid())
  acertou      Boolean
  tempo        Int      @default(0) // segundos gastos
  respondidaEm DateTime @default(now())

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questaoId     String
  questao       Questao     @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  alternativaId String
  alternativa   Alternativa @relation(fields: [alternativaId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questaoId])
}

model Revisao {
  id          String   @id @default(cuid())
  proximaData DateTime
  nivel       Int      @default(0) // 0->1d, 1->3d, 2->7d, 3->15d, 4->30d
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questaoId   String
  questao     Questao  @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  @@unique([userId, questaoId])
}

model Favorito {
  id        String   @id @default(cuid())
  criadoEm  DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questaoId String
  questao   Questao  @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  @@unique([userId, questaoId])
}

model Meta {
  id       String   @id @default(cuid())
  data     DateTime @default(now())
  questoes Int      @default(30)
  acerto   Int      @default(80) // % alvo
  minutos  Int      @default(60)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Resultado agregado de um simulado cronometrado. As respostas individuais
// continuam gravadas em Resposta (alimentam stats/historico/revisao); aqui
// guardamos so o resumo para o historico de simulados.
model Simulado {
  id           String   @id @default(cuid())
  total        Int // numero de questoes
  acertos      Int
  tempo        Int // segundos efetivamente gastos
  duracao      Int // limite de tempo escolhido (segundos)
  finalizadoEm DateTime @default(now())

  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  concursoId String?
  concurso   Concurso? @relation(fields: [concursoId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Reporte de uma questao feito por um usuario (ex.: gabarito errado, comentario
// errado). `motivos` e um CSV de ids de motivo (ver src/lib/reportes.ts);
// `comentario` e o texto livre opcional.
model Reporte {
  id         String   @id @default(cuid())
  motivos    String // CSV de ids de motivo
  comentario String?
  status     String   @default("aberto") // "aberto" | "resolvido"
  criadoEm   DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  questaoId String
  questao   Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([questaoId])
}

// ===================== Redacao =====================
// Modulo de redacao: a IA propoe um tema para o concurso com dois textos de
// apoio REAIS (buscados na web e conferidos contra a fonte), a pessoa escreve,
// e a IA corrige em cinco competencias de 0 a 200 — total de 0 a 1000.

model TemaRedacao {
  id       String   @id @default(cuid())
  tema     String
  comando  String
  banca    String?
  criadoEm DateTime @default(now())
  // `true` = tema que a propria pessoa trouxe de fora para corrigir um texto ja
  // escrito. Nao entra na lista de propostas do concurso: aquela lista e
  // conteudo compartilhado e curado, este aqui e insumo de uma correcao so.
  externo  Boolean  @default(false)

  concursoId String?
  concurso   Concurso? @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  // Quem gerou. O tema fica visivel para todos do concurso, como o resto do
  // conteudo — isto e so autoria.
  autorId    String?
  autor      User?     @relation(fields: [autorId], references: [id], onDelete: SetNull)

  textos   TextoApoio[]
  redacoes Redacao[]

  @@index([concursoId])
}

model TextoApoio {
  id        String  @id @default(cuid())
  trecho    String
  veiculo   String
  url       String
  ordem     Int     @default(0)
  // `true` = o trecho foi encontrado literalmente na pagina da URL. Quando
  // falso, a tela avisa que a citacao nao pode ser conferida automaticamente.
  conferido Boolean @default(false)

  temaId String
  tema   TemaRedacao @relation(fields: [temaId], references: [id], onDelete: Cascade)

  @@index([temaId])
}

model Redacao {
  id          String    @id @default(cuid())
  texto       String
  palavras    Int       @default(0)
  enviadaEm   DateTime  @default(now())
  corrigidaEm DateTime?

  // Resultado da correcao (nulos ate corrigir).
  total        Int?
  resumo       String?
  pontosFortes String? // uma por linha
  aMelhorar    String? // uma por linha

  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  temaId String
  tema   TemaRedacao @relation(fields: [temaId], references: [id], onDelete: Cascade)

  competencias CompetenciaNota[]

  @@index([userId])
  @@index([temaId])
}

model CompetenciaNota {
  id         String @id @default(cuid())
  numero     Int // 1..5
  nota       Int // 0..200
  comentario String

  redacaoId String
  redacao   Redacao @relation(fields: [redacaoId], references: [id], onDelete: Cascade)

  @@unique([redacaoId, numero])
}

// ===================== Notificacoes =====================
// Recado do sistema para quem estuda: novidade, atualizacao, manutencao, aviso.
// Escrito pelo admin, lido por todo mundo — nao ha resposta nem conversa.

model Notificacao {
  id       String   @id @default(cuid())
  tipo     String // ver TIPOS em src/lib/notificacoes.ts
  titulo   String
  corpo    String
  criadaEm DateTime @default(now())

  // Alcance. NULO = todo mundo; preenchido = so quem esta estudando aquele
  // concurso. Nao existe matricula neste app: o concurso do usuario e o que ele
  // tem selecionado no seletor, entao e por ele que o alcance e decidido.
  concursoId String?
  concurso   Concurso? @relation(fields: [concursoId], references: [id], onDelete: Cascade)

  // Quem escreveu. SetNull para que apagar um admin nao apague o comunicado que
  // ele mandou para todo mundo.
  autorId String?
  autor   User?   @relation("NotificacoesEnviadas", fields: [autorId], references: [id], onDelete: SetNull)

  leituras NotificacaoLida[]

  @@index([concursoId, criadaEm])
}

// Marca de leitura por pessoa. A ausencia de linha e o "nao lida" — assim uma
// notificacao nova ja nasce nao lida para todo mundo, sem precisar criar uma
// linha por usuario a cada envio.
model NotificacaoLida {
  id     String   @id @default(cuid())
  lidaEm DateTime @default(now())

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificacaoId String
  notificacao   Notificacao @relation(fields: [notificacaoId], references: [id], onDelete: Cascade)

  @@unique([userId, notificacaoId])
  @@index([userId])
}
